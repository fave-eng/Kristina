      "dialogueLines": [
        {
          "speaker": "A",
          "text": "Hello. I’d like to report a missing person – my aunt."
        },
        {
          "speaker": "B",
          "text": "OK, I’ll take a statement. ",
          "itemId": "1"
        },
        {
          "speaker": "A",
          "text": "She was supposed to be home four hours ago."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "2"
        },
        {
          "speaker": "A",
          "text": "Well, she’s 55 years old. She’s quite tall with long brown hair."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "3"
        },
        {
          "speaker": "A",
          "text": "Around five o’clock last night."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "4"
        },
        {
          "speaker": "A",
          "text": "At her house. I often go round on my way home from work."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "5"
        },
        {
          "speaker": "A",
          "text": "A purple T-shirt and a pair of black leggings."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "6"
        },
        {
          "speaker": "A",
          "text": "Well, I suppose she seemed a bit nervous."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "7"
        },
        {
          "speaker": "A",
          "text": "No, she didn’t mention anything."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "8"
        },
        {
          "speaker": "A",
          "text": "She works from 8.00 to 4.00. She’s always at home by 5.00."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "9"
        },
        {
          "speaker": "A",
          "text": "Yes, the front door was unlocked, which was strange."
        },
        {
          "speaker": "B",
          "text": "",
          "itemId": "10"
        },
        {
          "speaker": "A",
          "text": "Yes, there is one other thing. Her handbag was on the table."
        }
      ]
