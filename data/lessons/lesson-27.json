            "type": "gap",
            "id": "4",
            "input": "select",
            "answer": "wheat",
            "options": [
              "barn",
              "cockerel",
              "cows",
              "crops",
              "fences",
              "fields",
              "grass",
              "hens",
              "lambs",
              "ripe",
