            "input": "select",
            "answer": "ripe",
            "options": [
              "barn",
              "cockerel",
              "cows",
              "crops",
              "fences",
              "fields",
              "grass",
              "hens",
              "lambs",
              "ripe",
              "tractor",
              "wheat"
            ]
          },
          " corn, while in others there are animals peacefully eating ",
