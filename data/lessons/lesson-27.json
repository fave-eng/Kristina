          "One of the best ways to see the English countryside is from the air. Green ",
          {
            "type": "gap",
            "id": "1",
            "example": true,
            "answer": "fields"
          },
          " separated by hedges or ",
          {
            "type": "gap",
            "id": "2",
            "input": "select",
            "answer": "fences",
            "options": [
              "barn",
              "cockerel",
              "cows",
              "crops",
              "fences",
              "fields",
              "grass",
              "hens",
              "lambs",
              "ripe",
              "tractor",
              "wheat"
            ]
          },
          " stretch out below you as far as the eye can see. ",
          {
            "type": "gap",
            "id": "3",
            "input": "select",
            "answer": "crops",
            "options": [
              "barn",
              "cockerel",
              "cows",
              "crops",
              "fences",
              "fields",
              "grass",
              "hens",
              "lambs",
              "ripe",
              "tractor",
              "wheat"
            ]
          },
          " are growing in some of them, such as golden ",
